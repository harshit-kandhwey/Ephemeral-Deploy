# ── Stage 1: builder ─────────────────────────────────────────────────────────
# Identical to the API builder — same requirements.txt (shared layer cache)
# and same --target=/opt/deps, not a venv, reasoning. See
# docs/design-decisions.md#distroless-runtime-images.
FROM python:3.11-slim AS builder

RUN apt-get update && apt-get install -y --no-install-recommends \
    gcc \
    libpq-dev \
    && rm -rf /var/lib/apt/lists/*

COPY requirements.txt .
RUN pip install --no-cache-dir --upgrade pip \
    && pip install --no-cache-dir --target=/opt/deps -r requirements.txt


# ── Stage 2: runtime ─────────────────────────────────────────────────────────
# Distroless, not python:3.11-slim — no curl, no shell (ECS Exec drops into
# a python3 REPL instead once it exists). See
# docs/design-decisions.md#distroless-runtime-images.
FROM gcr.io/distroless/python3-debian12:nonroot

COPY --from=builder /opt/deps /opt/deps
ENV PYTHONPATH=/opt/deps \
    PYTHONDONTWRITEBYTECODE=1 \
    PYTHONUNBUFFERED=1

WORKDIR /app

# nonroot base already runs as uid 65532 — no separate useradd/USER step.
COPY --chown=65532:65532 . /app/

# Entrypoint lives outside /app so it is not shadowed by the source copy.
# Not exec'd directly (no shell to resolve a shebang) — passed as a script
# argument to the base image's own python3 entrypoint, see CMD below.
COPY --chown=65532:65532 entrypoint_worker.py /entrypoint_worker.py

# ── Entry point explanation ───────────────────────────────────────────────────
# No ENTRYPOINT override — distroless's own python3.11 is kept, and CMD's
# elements are its arguments. See docs/design-decisions.md#distroless-runtime-images.
#
# entrypoint_worker.py runs init_db before starting Celery.
# This ensures NexusAppUser and schema exist on every deploy
# without requiring a separate pipeline step. Idempotent.
#
# src.celery_worker:celery  → Celery needs the full dotted path from WORKDIR.
#                             WORKDIR is /app, so src.celery_worker resolves
#                             to /app/src/celery_worker.py.
#
# --concurrency 2           → 2 worker processes per container. Matches the
#                             256 CPU / 512 MB Fargate task size.
#
# beat's ECS task definition overrides this CMD with its own beat command,
# same entrypoint_worker.py-first convention — see terraform/modules/ecs.
# ─────────────────────────────────────────────────────────────────────────────
CMD ["/entrypoint_worker.py", "celery", "-A", "src.celery_worker:celery", "worker", \
    "--loglevel=info", \
    "--concurrency=2"]
